# Server-only — used to resolve /p/[shareId] preset share previews (og:image, metadata).
# Same Supabase project as the Lift app; SUPABASE_URL matches EXPO_PUBLIC_SUPABASE_URL there.
# SUPABASE_SERVICE_ROLE_KEY is the project's service_role secret — never expose with a
# NEXT_PUBLIC_ prefix, and never commit the real value.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
